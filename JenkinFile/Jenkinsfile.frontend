pipeline {
    agent any
    // Cung cấp thông tin cân thiết cho pipeline
    parameters {
        string(name: 'TAG_NAME', defaultValue: 'v2.0', description: 'Đây là tag mà bạn muốn gán chi image Docker')
        string(name: 'NAME_DOCKER', defaultValue: 'ribun', description: 'Tên của docker mà bạn sử dụng để lưu trữ image')
        string(name: 'NAME_IMAGE', defaultValue: 'taskmanagement_frontend', description: 'Tên của image Docker mà bạn muốn tạo')
    }
    // Khai báo các biến môi trường cần thiết
    environment {
        SCANNER_HOME = tool 'sonar-scanner' // Đường dẫn đến SonarQube Scanner
        SKIP_NOTIFY = 'false' // không cho phép bất chấp báo email
    }
    // Khai báo các công cụ cần thiết cho pipeline
    tools {
        nodejs 'node22'
    }
    stages {
        // Kiểm tra mã nguồn
        stage('Checkout from Git') {
            steps {
                checkout scm
            }
        }
        //Kiểm tra sự thay đổi của thư mục frontend
        stage('Detect changed frontend') {
            steps {
                script {
                    sh "git fetch origin ${env.BRANCH_NAME}"
                    def changes = sh(
                        script: "git diff --name-only origin/${env.BRANCH_NAME} HEAD",
                        returnStdout: true
                    ).trim().split("\n")

                    def changedFolder = changes.any {
                        it.startsWith("app/octaltask/")
                    }

                    if (!changedFolder) {
                        // không làm gì cả và kết thúc pipeline
                        echo "Không có file cập nhật được push, Kết thúc Pipeliine"
                        currentBuild.result = 'SUCCESS'
                        env.SKIP_NOTIFY = 'true'
                        return
                    }

                    echo "Phát hiện sự thay đổi trong thư mục app/octaltask(frontend)"
                    echo "Bắt đầu quá trình build pipeline"
                }
            }
        }
        // Thiết lập biến môi trường cần thiết cho quá trình build
        stage('SET UP ENVIRONMENT') {
            steps {
                script {
                    env.REPO_IMAGE  = "${params.NAME_DOCKER}/${params.NAME_IMAGE}:${params.TAG_NAME}"
                }
            }
        }
        // Cài đặt các dependecies cần thiết cho quá trình build
        stage('Install Dependencies') {
            steps {
                dir('app/octaltask') {
                    script{
                        sh '''
                            npm install
                            npm run build
                        '''
                    }
                }
            }
        }
        stage('Code Scan') {
            parallel {
                // Phân tích mã nguồn bằng SonarQube
                stage('Scan Code SonarQube') {
                    steps {
                        dir('app/octaltask') {
                            script {
                                withSonarQubeEnv('sonar-server') {
                                    sh """
                                        ${SCANNER_HOME}/bin/sonar-scanner \
                                        -Dsonar.projectName="TaskManagement_Frontend_Scan_Code" \
                                        -Dsonar.projectKey="ribunloc_taskmanagement_frontend" \
                                        -Dsonar.sources=.
                                    """
                                }
                            }
                        }
                    }
                }
                // Dùng snyk để quét mã nguồn
                stage('Snyk Scan Source Code') {
                    steps {
                        dir('app/octaltask') {
                            script {
                                withCredentials([string(credentialsId: 'snyk', variable: 'SNYK_TOKEN')]) {
                                    sh '''
                                        mkdir -p reports/snyk
                                        snyk auth $SNYK_TOKEN
                                        snyk test . --all-projects \
                                        --severity-threshold=medium \
                                        --json > reports/snyk/snyk-report.json || true
                                        snyk monitor --all-projects
                                    '''
                                }
                            }
                        }
                    }
                }
            }
        }
        // Thực hiện build và đóng gói ứng dụng thành Docker image
        stage('Docker Build') {
            steps{
                dir('app/octaltask') {
                    script {
                        sh "docker build -t ${params.NAME_IMAGE} ."
                    }
                }
            }
        }
        // Dùng trivy scan image để quét lỗ hỗng bảo mật trong container
        stage('Trivy Scan Image') {
            steps {
                script {
                    sh """
                        mkdir -p reports/trivy
                        trivy image --severity MEDIUM,HIGH,CRITICAL \
                        --exit-code 1 \
                        --format json \
                        --output reports/trivy/trivy-report.json \
                        "${params.NAME_IMAGE}" || true
                    """
                }
            }
        }
        // Đẩy repo image lên kho chứa Docker
        stage('Push Image to Docker Registry') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        sh """
                            docker tag ${params.NAME_IMAGE} ${REPO_IMAGE}
                            docker push ${REPO_IMAGE}
                        """
                    }
                }
            }
        }
        // Xóa container cũ nếu có
        stage('Remove container') {
            steps {
                sh "docker stop ${params.NAME_IMAGE} | true"
                sh "docker rm ${params.NAME_IMAGE} | true"
            }
        }
        // Chạy container mới từ image đã đẩy lên kho chứa
        stage('Run container'){
            steps{
                script {
                    def mySecrets = [
                        [
                            path: 'secrets/frontend/api',
                            engineVersion: 1,
                            secretValues: [
                                [envVar: 'VITE_API_BASE', vaultKey: 'VITE_API_BASE']
                            ]
                        ]
                    ]
                    def configuration = [
                        vaultUrl: 'http://vault.netsena.io.vn:8200',
                        vaultCredentialId: 'vault-jenkins-role',
                        engineVersion: 1
                    ]
                    withVault(
                        [configuration: configuration, vaultSecrets: mySecrets]
                    ){
                        sh """
                            echo "VITE_API_BASE=${VITE_API_BASE}" > .env
                            docker run -d --name ${params.NAME_IMAGE} \
                            --env-file .env \
                            -p 5173:5173 ${REPO_IMAGE}
                            rm -rf .env
                        """
                    }
                }
            }
        }
        // Update file yaml để argoCD fetch
        stage('Update file Yaml to ArgoCD Sync') {
            steps {
                script {
                    def getTime = new Date().format("yyyMMdd-HHmmss")
                    def newTag  = "${params.TAG_NAME}-${getTime}"
                    def yamlPath = "k8s-deployment/frontend/2-deployment.yaml"

                    echo "Cập nhật file YAML ${yamlPath} với tag: ${newTag}"

                    def image     = "${params.NAME_DOCKER}/${params.NAME_IMAGE}"
                    def imageName = "${params.NAME_DOCKER}/${params.NAME_IMAGE}:${newTag}"
                    echo "Thay tag cho image frontend -> ${imageName}"

                    sh """
                        yq e '(.spec.template.spec.containers[] | select(.image | test("${image}")).image) = "${imageName}" -i ${yamlPath}'
                    """

                    //commit vào mã nguồn
                    withCredentials([usernamePassword(
                        credentialsId: 'github-token',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )]) {
                        sh """
                            git config user.name = "Jenkins server"
                            git config user.email = "hothanhloc12345@gmail.com"
                            git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/RibunLoc/DevOps-work-management-web-platform.git

                            git pull --rebase origin ${env.BRANCH_NAME} || true

                            git add ${yamlPath}
                            git commit -m "ci: update new tag for ArgoCD - ${newTag}" || echo "Không có thay đổi"
                            git push origin ${env.BRANCH_NAME}
                        """
                    }
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'reports/**', fingerprint: true
            script {
                if (env.SKIP_NOTIFY == 'true') {
                    echo "Bỏ qua email vì không có thay đổi!"
                    return
                }
                // báo email về hothanhloc12345@gmail.com
                def trangThai = currentBuild.currentResult
                def nguoiBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')[0]?.userId ?: 'Github User'
                emailext (
                    subject: "[Jenkins] Pipeline ${trangThai}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """
                        <html>
                                <body style="font-family: Arial, sans-serif; font-size: 14px;">
                                    <h2 style="color: #0073e6;">Jenkins Pipeline Notification</h2>
                                    <p><strong>Build summary:</strong></p>
                                    <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
                                        <tr>
                                            <td><strong>Dự án</strong></td>
                                            <td>${env.JOB_NAME}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Thứ tự Build</strong></td>
                                            <td>#${env.BUILD_NUMBER}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Trạng thái</strong></td>
                                            <td style="color: ${buildStatus == 'SUCCESS' ? 'green' : 'red'};"><strong>${buildStatus}</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Được Trigger bởi</strong></td>
                                            <td>${nguoiBuild}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Xem chi tiết tại đây</strong></td>
                                            <td><a href="${env.BUILD_URL}">${env.BUILD_URL}</a></td>
                                        </tr>
                                    </table>

                                    <p style="margin-top: 20px;">Reports attached (if available): Trivy, Snyk</p>

                                    <p style="font-size: 12px; color: #999;">Jenkins DevOps Notification System</p>
                                </body>
                        </html>
                    """,
                    to: 'hothanhloc12345@gmail.com',
                    from: 'hothanhloc12345@gmail.com',
                    replyTo: '22520787@gm.uit.edu.vn',
                    mimeType: 'text/html',
                    attachmentsPattern: 'reports/trivy/trivy-report-*.json, reports/snyk/snyk-report-*.json'
                )
            }
        }
        success {
            echo 'Deployment successful!'
        }
        failure {
            echo 'Deployment failed!'
        }
    }
}