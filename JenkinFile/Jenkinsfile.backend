// tạo hàm duyệt từng service, cho phép giới hạn lần chạy
def buildServices(noidung, lenhthucthi, limit = 0) {
    def rawList = env.TARGET_SERVICES ?: ''
    def services = rawList.split(',').collect { it.trim() }.findAll { it }

    def buildTheoDot = { dot ->
        def jobs = [:]
        for (String svc in dot) {
            jobs["${noidung} : ${svc}"] = {
                lenhthucthi(svc)
            }
        }
        parallel jobs
    }
    // Nếu bằng 0 build song song (default)
    if (limit <= 0) {
        buildTheoDot(services)
    } else {
        // ngược lại build từng đợt
        services.each { svc ->
            lenhthucthi(svc)
        }
    }
}

pipeline {
    agent none
    // Cung cấp thông tin cần thiết cho pipeline
    parameters {
        string(name: 'TAG_NAME', defaultValue: 'v1.0', description: 'Tag image Docker')
        string(name: 'NAME_DOCKER', defaultValue: 'ribun', description: 'Docker username hoặc registry repo')
    }
    // Khai báo các biến môi trường cần thiết
    environment {
        SKIP_NOTIFY = 'false' // không cho phép bất chấp báo email
        def getTime = new Date().format("yyyyMMdd-HHmmss")
        NEW_TAG = "${params.TAG_NAME}-${getTime}"
    }
    // Khai báo các công cụ cần thiết cho pipeline
    tools {
        nodejs 'node22'
    }
    stages {
        // Kiểm tra mã nguồn
        stage('Checkout from Git') {
            agent { label 'agent1' }
            steps {
                checkout scm
            }
        }
        // Kiểm tra từng dịch vụ xem có sự cập nhật hay không bằng cách so sánh khác biệt của base cũ và mới
        stage('Detect Changed Folder') {
            agent { label 'agent1' }
            steps {
                script {
                    sh "git fetch origin ${env.BRANCH_NAME}"

                    def changes = sh(
                        script: "git diff --name-only HEAD~1 HEAD",
                        returnStdout: true
                    ).trim().split("\n")

                    def folders = ['api-gateway', 'auth-service', 'task-service', 'user-service', 'file-service']
                    def changedServices = folders.findAll {
                        svc -> changes.any { 
                            it.startsWith("app/octaltask-api/${svc}/") 
                        }
                    }

                    if (changedServices.isEmpty()) {
                        echo "Không phát hiện service nào thay đổi. Kết thúc pipeline"
                        currentBuild.result = 'SUCCESS'
                        env.SKIP_NOTIFY = 'true'
                        return
                    }

                    echo "Những dịch vụ cần build: ${changedServices.join(', ')}"
                    env.TARGET_SERVICES = changedServices.join(',')
                }
            }
        }
        // Cài đặt các dependencies cần thiết cho quá trình build
        stage('Install Dependencies') {
            agent { label 'agent1' }
            when  {
                expression { return env.TARGET_SERVICES }
            }
            steps {
                script {
                    buildServices("Cài đặt thư viện cần thiết npm") { svc ->
                        dir("app/octaltask-api/${svc}/"){
                            echo "Bắt đầu quá trình cài đặt thư viện..."
                            sh '''
                                npm install
                                npm run build
                            '''
                        }
                    }
                }
            }
        }
        // Phân tích mã nguồn đảm bảo Security
        stage('Scan code') {
            when {
                expression { return env.TARGET_SERVICES }
            }
            parallel {
                stage('Scan Code with SonarQube') {
                    agent { label 'agent1' }
                    environment { SCANNER_HOME = tool 'sonar-scanner' }
                    steps {
                        script {
                            buildServices("Sonar Scan", { svc ->
                                dir("app/octaltask-api/${svc}/"){
                                        withSonarQubeEnv('sonar-server') {
                                        echo "Sonar Server scan ${svc}..."
                                        sh '''
                                            $SCANNER_HOME/bin/sonar-scanner \
                                            -Dsonar.projectName="${svc}_Task_Management_Backend" \
                                            -Dsonar.projectKey="${svc}_taskmanagement_backend" \
                                            -Dsonar.sources=. || true
                                        '''
                                    }
                                    // Đợi kết quả đánh giá chất lượng từ sonar
                                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                                }
                            }, 1)
                        }
                    }
                }

                stage('Scan Code with Snyk') {
                    agent { label 'agent1' }
                    steps {
                        script {
                            withCredentials([
                                string(credentialsId: 'snyk', variable: 'SNYK_TOKEN')
                            ]) {
                                // tạo thư mục lưu trữ báo cáo
                                sh('mkdir -p reports/snyk')
                                buildServices("Snyk Scan", { svc ->
                                    dir("app/octaltask-api/${svc}/"){
                                        echo "Snyk scan ${svc}..."
                                        sh """
                                            snyk auth \$SNYK_TOKEN
                                            snyk test --file=package.json \
                                            --severity-threshold=medium \
                                            --json > reports/snyk/snyk-report-${svc}.json || true
                                            snyk monitor --file=package.json || true
                                        """
                                    }
                                })
                            }
                        }
                    }
                }
            }
        }
        // Thực hiện build và đóng gói ứng dụng thành Docker image
        stage('Docker Build') {
            agent { label 'agent1' }
            when {
                expression { return env.TARGET_SERVICES }
            }
            steps {
                script {
                    buildServices("Build Image", { svc ->
                        dir("app/octaltask-api/${svc}/"){
                            echo("Bắt đầu quá trình build docker cho dịch vụ ${svc}...")
                            sh "docker build -t ${svc} ."
                        }
                    }, 1)
                }
            }
        }
        // Đảm bảo image phải sạch bằng cách dùng trivy tri
        stage('Trivy Scan Image') {
            agent { label 'agent1' }
            when {
                expression { return env.TARGET_SERVICES }
            }
            steps {
                buildServices("Trivy Scan", { svc ->
                    dir("app/octaltask-api/${svc}/") {
                        echo "Bắt đầu quá trình scan Iamge ${svc}"
                        sh """
                            mkdir -p reports/trivy
                            trivy image --severity MEDIUM,HIGH,CRITICAL \
                            --exit-code 1 \
                            --format json \
                            --output reports/trivy/trivy-report-${svc}.json \
                            "${svc}" || true
                        """
                    }
                })
            }
        }
        // Đẩy repo image lên kho chứa Docker
        stage('Push Image to Docker Registry') {
            agent { label 'agent1' }
            when  {
                expression { return env.TARGET_SERVICES }
            }
            steps {
                script { 
                    withDockerRegistry(credentialsId: 'docker', toolName: 'docker') {
                        buildServices("Đẩy Image lên repo ${params.NAME_DOCKER}", { svc ->
                            dir("app/octaltask-api/${svc}/"){
                                def image = "${params.NAME_DOCKER}/task-management-develop-${svc}:${env.NEW_TAG}"
                                echo "Bắt đầu quá trình đẩy image..."
                                sh """
                                    docker tag ${svc} ${image}
                                    docker push ${image}
                                    docker rmi ${svc} || true
                                    docker rmi ${image} || true
                                """
                            }
                        }, 1)
                    }
                }
            }
        }
        // Update file yaml để argoCD fetch
        stage('Update file Yaml to ArgoCD Sync') {
            agent {label 'agent1' }
            when {
                expression { return env.TARGET_SERVICES }
            }
            steps {
                // clone repo gitops riêng
                dir('gitOps') {
                    checkout([$class: 'GitSCM',
                        branches: [[name: "*/${env.BRANCH_NAME}"]],
                        userRemoteConfigs: [[
                            url: 'https://github.com/RibunLoc/DevOps-task-management-gitops.git',
                            credentialsId: 'github-token'
                        ]]
                    ])
                    script {
                        def yamlPath = "k8s-deployment/backend/1-deployment.yaml"
                        withCredentials([usernamePassword(
                            credentialsId: 'github-token',
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )]) {
                            // cấu hình git
                            sh """
                                git config user.name = "Jenkins Backend"
                                git config user.email = "hothanhloc12345@gmail.com"
                                git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/RibunLoc/DevOps-task-management-gitops.git
                            """
                            buildServices("Cập nhật services", { svc ->
                                def image     = "${params.NAME_DOCKER}/task-management-develop-${svc}"
                                def imageTag  = "${image}:${env.NEW_TAG}"
                                echo "Thay tag cho image backend -> ${svc}"

                                sh """
                                    git checkout ${env.BRANCH_NAME} || git checkout -b ${env.BRANCH_NAME}
                                    git pull origin ${env.BRANCH_NAME} || true

                                    yq e '(.spec.template.spec.containers[] | select(.image | test("${image}")).image) = "${imageTag}"' -i ${yamlPath}

                                    git add ${yamlPath}
                                    git commit -m "ci: update new tag for ArgoCD - ${env.NEW_TAG}" || echo "Không có thay đổi"
                                    git push origin ${env.BRANCH_NAME}
                                """
                            }, 1)
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.SKIP_NOTIFY == 'true') {
                    echo "Bỏ qua email vì không có thay đổi!"
                    return
                }
                // báo email về hothanhloc12345@gmail.com
                def trangThai = currentBuild.currentResult
                def nguoiBuild = currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')[0]?.userId ?: 'Github User'
                emailext (
                    subject: "[Jenkins] Pipeline ${trangThai}: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                    body: """
                        <html>
                                <body style="font-family: Arial, sans-serif; font-size: 14px;">
                                    <h2 style="color: #0073e6;">Jenkins Pipeline Notification</h2>
                                    <p><strong>Build summary:</strong></p>
                                    <table border="1" cellpadding="6" cellspacing="0" style="border-collapse: collapse;">
                                        <tr>
                                            <td><strong>Dự án</strong></td>
                                            <td>${env.JOB_NAME}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Thứ tự Build</strong></td>
                                            <td>#${env.BUILD_NUMBER}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Trạng thái</strong></td>
                                            <td style="color: ${trangThai == 'SUCCESS' ? 'green' : 'red'};"><strong>${trangThai}</strong></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Được Trigger bởi</strong></td>
                                            <td>${nguoiBuild}</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Xem chi tiết tại đây</strong></td>
                                            <td><a href="${env.BUILD_URL}">${env.BUILD_URL}</a></td>
                                        </tr>
                                    </table>

                                    <p style="margin-top: 20px;">Reports attached (if available): Trivy, Snyk</p>

                                    <p style="font-size: 12px; color: #999;">Jenkins DevOps Notification System</p>
                                </body>
                        </html>
                    """,
                    to: 'hothanhloc12345@gmail.com',
                    from: 'hothanhloc12345@gmail.com',
                    replyTo: '22520787@gm.uit.edu.vn',
                    mimeType: 'text/html',
                    attachmentsPattern: 'reports/trivy/trivy-report-*.json, reports/snyk/snyk-report-*.json'
                )
            }
        }
    }
}